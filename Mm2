function aimbotMurderer()
    if not _G.MM2.aimbot then return end
    local murderer, minDist = nil, math.huge
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LP and p.Character and getRole(p) == "Murderer" then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            local myHrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            if hrp and myHrp then
                local d = (myHrp.Position - hrp.Position).Magnitude
                if d < minDist then minDist = d; murderer = hrp end
            end
        end
    end
    if murderer and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
        LP.Character.HumanoidRootPart.CFrame = CFrame.new(LP.Character.HumanoidRootPart.Position, murderer.Position)
    end
end

function autoGun()
    if not _G.MM2.autoGun then return end
    local sheriffAlive = false
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LP and p.Character and getRole(p) == "Sheriff" then sheriffAlive = true; break end
    end
    if not sheriffAlive then
        local gunPart = findDroppedGun()
        if gunPart then
            local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local targetPos = gunPart.Position + Vector3.new(0, 3, 0)
                local dist = (hrp.Position - targetPos).Magnitude
                if dist > 5 then
                    local tiempo = math.max(dist / _G.MM2.rutaSpeed, 0.1)
                    TweenService:Create(hrp, TweenInfo.new(tiempo, Enum.EasingStyle.Linear), {CFrame = CFrame.new(targetPos)}):Play()
                end
            end
        end
    end
end

function autoEquipGun()
    if not _G.MM2.autoEquip then return end
    local bp = LP:FindFirstChild("Backpack")
    if not bp then return end
    local gun = bp:FindFirstChild("Gun") or bp:FindFirstChild("Revolver")
    if not gun or not LP.Character then return end
    local murdererNear = false
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LP and p.Character and getRole(p) == "Murderer" then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if hrp and LP.Character:FindFirstChild("HumanoidRootPart") then
                if (LP.Character.HumanoidRootPart.Position - hrp.Position).Magnitude < 25 then murdererNear = true; break end
            end
        end
    end
    if not murdererNear then gun.Parent = LP.Character end
end

-- AUTO KILL CON TP Y REGRESO
function autoKill()
    if not _G.MM2.autoKill then return end
    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    if _G.MM2.autoEquipKnife then
        local bp = LP:FindFirstChild("Backpack")
        if bp and char:FindFirstChild("Humanoid") then
            local knife = bp:FindFirstChild("Knife")
            if knife then
                pcall(function() char.Humanoid:EquipTool(knife) end)
                if knife.Parent ~= char then knife.Parent = char end
            end
        end
    end
    
    local tool = char:FindFirstChildWhichIsA("Tool")
    if not tool then return end
    
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local eHrp = p.Character:FindFirstChild("HumanoidRootPart")
            local eHum = p.Character:FindFirstChild("Humanoid")
            if eHrp and eHum and eHum.Health > 0 then
                local dist = (hrp.Position - eHrp.Position).Magnitude
                if dist < 200 then 
                    local originalPos = hrp.CFrame
                    hrp.CFrame = CFrame.new(eHrp.Position + Vector3.new(2, 0, 0))
                    hrp.CFrame = CFrame.new(hrp.Position, eHrp.Position)
                    pcall(function() tool:Activate() end)
                    task.wait(0.1)
                    hrp.CFrame = originalPos
                    task.wait(0.5)
                end
            end
        end
    end
end

-- 1. AUTO COINS (SOLO MONEDAS)
function startCoinFarm()
    if coinThread then return end 
    
    coinThread = task.spawn(function()
        while _G.MM2.autoCoins do
            local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            if not hrp then task.wait(0.1); continue end
            
            local danger = false
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LP and p.Character and getRole(p) == "Murderer" then
                    local hum = p.Character:FindFirstChild("Humanoid")
                    if hum and hum.Health > 0 then danger = true; break end
                end
            end
            
            if not danger then
                local nearestCoin, minDist = nil, math.huge
                for _, obj in pairs(workspace:GetDescendants()) do
                    local name = obj.Name:lower()
                    if (name:find("coin") or name:find("money") or name:find("cash") or name:find("moneda")) and obj:IsA("BasePart") then
                        local dist = (hrp.Position - obj.Position).Magnitude
                        if dist < minDist then minDist = dist; nearestCoin = obj end
                    end
                end
                
                if nearestCoin then
                    local targetPos = nearestCoin.Position
                    
                    if not liveFarmTracer or not liveFarmTracer.Parent then
                        liveFarmTracer = Instance.new("Part")
                        liveFarmTracer.Name = "LiveFarmTracer"
                        liveFarmTracer.Anchored = true; liveFarmTracer.CanCollide = false
                        liveFarmTracer.Transparency = 0.4; liveFarmTracer.Material = Enum.Material.Neon
                        liveFarmTracer.Color = Color3.fromRGB(0, 150, 255)
                        liveFarmTracer.Size = Vector3.new(0.3, 0.3, 1)
                        liveFarmTracer.Parent = workspace
                    end
                    
                    local tiempo = math.max(minDist / (_G.MM2.rutaSpeed * 5), 0.01)
                    local tween = TweenService:Create(hrp, TweenInfo.new(tiempo, Enum.EasingStyle.Linear), {CFrame = CFrame.new(targetPos)})
                    
                    local heartbeatConn
                    heartbeatConn = RunService.Heartbeat:Connect(function()
                        if liveFarmTracer and liveFarmTracer.Parent and hrp and hrp.Parent then
                            local distance = (targetPos - hrp.Position).Magnitude
                            liveFarmTracer.Size = Vector3.new(0.3, 0.3, math.max(distance, 0.1))
                            liveFarmTracer.CFrame = CFrame.new(hrp.Position, targetPos) * CFrame.new(0, 0, -distance/2)
                        end
                    end)
                    
                    tween:Play()
                    
                    local completed = false
                    tween.Completed:Connect(function() completed = true end)
                    while not completed and hrp and hrp.Parent do task.wait(0.1) end
                    if not hrp or not hrp.Parent then break end

                    local cd = nearestCoin:FindFirstChildWhichIsA("ClickDetector")
                    if cd then 
                        for i = 1, 5 do pcall(function() fireclickdetector(cd) end); task.wait(0.005) end
                    end
                    
                    if heartbeatConn then heartbeatConn:Disconnect() end
                    if liveFarmTracer and liveFarmTracer.Parent then liveFarmTracer:Destroy(); liveFarmTracer = nil end
                    task.wait(0.01)
                else
                    if liveFarmTracer and liveFarmTracer.Parent then liveFarmTracer:Destroy(); liveFarmTracer = nil end
                    task.wait(0.05)
                end
            else
                task.wait(0.5)
            end
        end
        if liveFarmTracer and liveFarmTracer.Parent then liveFarmTracer:Destroy(); liveFarmTracer = nil end
        coinThread = nil
    end)
end

-- 2. AUTO XP (TP AL TECHO)
function startXpFarm()
    if xpThread then return end 
    
    local SAFE_HEIGHT = 50 
    local isAtSafeHeight = false
    
    xpThread = task.spawn(function()
        while _G.MM2.autoXp do
            local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            if not hrp then task.wait(0.1); continue end
            
            local murdererAlive = false
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LP and p.Character and getRole(p) == "Murderer" then
                    local hum = p.Character:FindFirstChild("Humanoid")
                    if hum and hum.Health > 0 then
                        murdererAlive = true
                        break
                    end
                end
            end
            
            if murdererAlive then
                if not isAtSafeHeight then
                    hrp.CFrame = CFrame.new(hrp.Position.X, SAFE_HEIGHT, hrp.Position.Z)
                    isAtSafeHeight = true
                end
                task.wait(0.5)
            else
                if isAtSafeHeight then
                    hrp.CFrame = CFrame.new(hrp.Position.X, 5, hrp.Position.Z)
                    isAtSafeHeight = false
                end
                task.wait(0.5)
            end
        end
        xpThread = nil
    end)
end

function drawRouteTracer(pos1, pos2)
    if not pos1 or not pos2 then return end
    local distance = (pos2 - pos1).Magnitude
    if distance < 0.5 then return end
    local part = Instance.new("Part")
    part.Name = "RouteTracer"
    part.Size = Vector3.new(0.4, 0.4, distance)
    part.Anchored = true; part.CanCollide = false
    part.Transparency = 0.3; part.Material = Enum.Material.Neon
    part.Color = Color3.fromRGB(0, 150, 255)
    part.CFrame = CFrame.new(pos1, pos2) * CFrame.new(0, 0, -distance/2)
    part.Parent = workspace
    table.insert(routeTracers, part)
end

function clearRouteTracers()
    for _, t in pairs(routeTracers) do if t and t.Parent then t:Destroy() end end
    routeTracers = {}
end

function GrabarRuta()
    if grabando then return end
    Ruta = {}; grabando = true; clearRouteTracers()
    task.spawn(function()
        while grabando do
            task.wait(0.3)
            local char = LP.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local currentPos = char.HumanoidRootPart.Position
                table.insert(Ruta, char.HumanoidRootPart.CFrame)
                if #Ruta > 1 then drawRouteTracer(Ruta[#Ruta - 1].Position, currentPos) end
            end
        end
    end)
end

function PararGrabacion() grabando = false end

function IniciarRuta()
    if jugandoRuta or #Ruta == 0 then return end
    jugandoRuta = true
    task.spawn(function()
        while jugandoRuta do
            for i, cf in ipairs(Ruta) do
                if not jugandoRuta then break end
                local char = LP.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local root = char.HumanoidRootPart
                    local targetPos = cf.Position
                    local tiempo = math.max((targetPos - root.Position).Magnitude / _G.MM2.rutaSpeed, 0.1)
                    if not liveRouteTracer or not liveRouteTracer.Parent then
                        liveRouteTracer = Instance.new("Part")
                        liveRouteTracer.Name = "LiveRouteTracer"
                        liveRouteTracer.Anchored = true; liveRouteTracer.CanCollide = false
                        liveRouteTracer.Transparency = 0.3; liveRouteTracer.Material = Enum.Material.Neon
                        liveRouteTracer.Color = Color3.fromRGB(0, 150, 255)
                        liveRouteTracer.Size = Vector3.new(0.4, 0.4, 1)
                        liveRouteTracer.Parent = workspace
                    end
                    local heartbeatConn
                    heartbeatConn = RunService.Heartbeat:Connect(function()
                        if liveRouteTracer and liveRouteTracer.Parent and root and root.Parent then
                            local distance = (targetPos - root.Position).Magnitude
                            liveRouteTracer.Size = Vector3.new(0.4, 0.4, math.max(distance, 0.1))
                            liveRouteTracer.CFrame = CFrame.new(root.Position, targetPos) * CFrame.new(0, 0, -distance/2)
                        end
                    end)
                    local tween = TweenService:Create(root, TweenInfo.new(tiempo, Enum.EasingStyle.Linear), {CFrame = cf})
                    tween:Play()
                    tween.Completed:Wait()
                    if heartbeatConn then heartbeatConn:Disconnect() end
                    if liveRouteTracer and liveRouteTracer.Parent then liveRouteTracer:Destroy(); liveRouteTracer = nil end
                    task.wait(0.05)
                end
            end
            task.wait(0.2)
        end
        if liveRouteTracer and liveRouteTracer.Parent then liveRouteTracer:Destroy(); liveRouteTracer = nil end
    end)
end

function PararRuta() 
    jugandoRuta = false
    if liveRouteTracer and liveRouteTracer.Parent then liveRouteTracer:Destroy(); liveRouteTracer = nil end
end

