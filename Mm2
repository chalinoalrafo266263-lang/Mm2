function updateESP()
    if not _G.MM2.esp then
        for _, data in pairs(espCache) do 
            if data.billboard and data.billboard.Parent then data.billboard:Destroy() end 
        end
        espCache = {}
        return
    end
    
    local activePlayers = {}
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LP and player.Character then
            activePlayers[player] = true
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local role = getRole(player)
                local color = Color3.fromRGB(0, 255, 0)
                if role == "Murderer" then color = Color3.fromRGB(255, 0, 0)
                elseif role == "Sheriff" then color = Color3.fromRGB(0, 100, 255) end
                
                if not espCache[player] then
                    local billboard = Instance.new("BillboardGui")
                    billboard.Name = "ESP_Billboard"
                    billboard.Size = UDim2.new(0, 120, 0, 30)
                    billboard.StudsOffset = Vector3.new(0, 3, 0)
                    billboard.AlwaysOnTop = true
                    billboard.Parent = hrp
                    
                    local label = Instance.new("TextLabel")
                    label.Name = "ESP_Label"
                    label.Size = UDim2.new(1, 0, 1, 0)
                    label.BackgroundTransparency = 1
                    label.TextColor3 = color
                    label.TextStrokeTransparency = 0
                    label.TextSize = 16
                    label.Font = Enum.Font.GothamBold
                    label.Parent = billboard
                    
                    espCache[player] = {billboard = billboard, label = label}
                else
                    local data = espCache[player]
                    if data.billboard.Parent ~= hrp then
                        data.billboard.Parent = hrp
                    end
                    data.label.Text = player.Name .. " [" .. role .. "]"
                    data.label.TextColor3 = color
                end
            end
        end
    end
    
    for player, data in pairs(espCache) do
        if not activePlayers[player] or not player.Character then
            if data.billboard and data.billboard.Parent then data.billboard:Destroy() end
            espCache[player] = nil
        end
    end
end

function findDroppedGun()
    for _, obj in pairs(workspace:GetChildren()) do
        if obj:IsA("Tool") or obj:IsA("Model") then
            local name = obj.Name:lower()
            if name:find("gun") or name:find("revolver") or name:find("weapon") then
                if not obj.Parent:IsA("Backpack") and not obj.Parent:IsA("Character") then
                    if obj:IsA("Tool") and obj.Handle then return obj.Handle end
                    if obj:IsA("Model") and obj.PrimaryPart then return obj.PrimaryPart end
                end
            end
        end
    end
    return nil
end

