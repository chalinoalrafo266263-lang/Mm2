-- INVISIBILIDAD CORREGIDA
local invisibilityEnabled = false
local invisibilityConnection = nil
local originalTransparencies = {}

function enableInvisibility()
    if invisibilityEnabled then return end
    invisibilityEnabled = true
    
    local function makeInvisible(char)
        if not char then return end
        for _, descendant in ipairs(char:GetDescendants()) do
            if descendant:IsA("BasePart") then
                originalTransparencies[descendant] = descendant.Transparency
                descendant.Transparency = 1
            elseif descendant:IsA("Decal") or descendant:IsA("Texture") then
                originalTransparencies[descendant] = descendant.Transparency
                descendant.Transparency = 1
            end
        end
        for _, acc in ipairs(char:GetChildren()) do
            if acc:IsA("Accessory") then
                for _, part in ipairs(acc:GetDescendants()) do
                    if part:IsA("BasePart") or part:IsA("Decal") then
                        originalTransparencies[part] = part.Transparency
                        part.Transparency = 1
                    end
                end
            end
        end
    end
    
    if LP.Character then makeInvisible(LP.Character) end
    
    invisibilityConnection = LP.CharacterAdded:Connect(function(char)
        char:WaitForChild("Humanoid")
        if invisibilityEnabled then
            task.wait(0.5)
            makeInvisible(char)
        end
    end)
end

function disableInvisibility()
    invisibilityEnabled = false
    for part, transparency in pairs(originalTransparencies) do
        if part and part.Parent then part.Transparency = transparency end
    end
    originalTransparencies = {}
    if invisibilityConnection then
        invisibilityConnection:Disconnect()
        invisibilityConnection = nil
    end
end

