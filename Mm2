-- 4. FPS BOOST
local fpsBoostEnabled = false
local originalSettings = {}
local lighting = game:GetService("Lighting")

function applyFpsBoost()
    if fpsBoostEnabled then return end
    fpsBoostEnabled = true
    originalSettings.ParticleEmissionRate = settings().Rendering.ParticleEmissionRate
    originalSettings.ShadowEnabled = settings().Rendering.ShadowEnabled
    pcall(function()
        settings().Rendering.ParticleEmissionRate = 0
        settings().Rendering.ShadowEnabled = false
    end)
    for _, descendant in pairs(workspace:GetDescendants()) do
        if descendant:IsA("ParticleEmitter") or descendant:IsA("Trail") then
            if not descendant:GetAttribute("OriginalEnabled") then
                descendant:SetAttribute("OriginalEnabled", descendant.Enabled)
                descendant.Enabled = false
            end
        elseif descendant:IsA("Beam") then
            if not descendant:GetAttribute("OriginalEnabled") then
                descendant:SetAttribute("OriginalEnabled", descendant.Enabled)
                descendant.Enabled = false
            end
        end
    end
    pcall(function()
        lighting.GlobalShadows = false
        lighting.EnvironmentDiffuseScale = 0
        lighting.EnvironmentSpecularScale = 0
    end)
end

function removeFpsBoost()
    if not fpsBoostEnabled then return end
    fpsBoostEnabled = false
    pcall(function()
        settings().Rendering.ParticleEmissionRate = originalSettings.ParticleEmissionRate or 1
        settings().Rendering.ShadowEnabled = originalSettings.ShadowEnabled or true
    end)
    for _, descendant in pairs(workspace:GetDescendants()) do
        if descendant:IsA("ParticleEmitter") or descendant:IsA("Trail") or descendant:IsA("Beam") then
            local original = descendant:GetAttribute("OriginalEnabled")
            if original ~= nil then
                descendant.Enabled = original
                descendant:SetAttribute("OriginalEnabled", nil)
            end
        end
    end
    pcall(function()
        lighting.GlobalShadows = true
        lighting.EnvironmentDiffuseScale = 1
        lighting.EnvironmentSpecularScale = 1
    end)
end

-- 5. GOD MODE REAL E INFINITO
local godModeEnabled = false
local godModeThread = nil
local godConnections = {}

function enableGodMode()
    if godModeEnabled then return end
    godModeEnabled = true
    
    godModeThread = task.spawn(function()
        while godModeEnabled do
            task.wait(0.05)
            if LP.Character then
                local hum = LP.Character:FindFirstChild("Humanoid")
                if hum and hum.Health < hum.MaxHealth then
                    hum.Health = hum.MaxHealth
                end
            end
        end
    end)
    
    local function hookCharacter(char)
        for _, child in ipairs(char:GetDescendants()) do
            if child:IsA("RemoteEvent") then
                local name = child.Name:lower()
                if name:find("damage") or name:find("hit") or name:find("slash") or 
                   name:find("attack") or name:find("kill") or name:find("stab") then
                    local originalFireServer = child.FireServer
                    child.FireServer = function(self, ...)
                        if godModeEnabled then return nil
                        else return originalFireServer(self, ...) end
                    end
                end
            end
        end
        
        local hum = char:FindFirstChild("Humanoid")
        if hum then
            local conn1 = hum.HealthChanged:Connect(function(newHealth)
                if godModeEnabled and newHealth < hum.MaxHealth then
                    task.defer(function() hum.Health = hum.MaxHealth end)
                end
            end)
            local conn2 = hum.Died:Connect(function()
                if godModeEnabled then
                    task.wait(0.01)
                    pcall(function()
                        hum.Health = hum.MaxHealth
                        hum:ChangeState(Enum.HumanoidStateType.GettingUp)
                    end)
                end
            end)
            table.insert(godConnections, conn1)
            table.insert(godConnections, conn2)
        end
    end
    
    if LP.Character then hookCharacter(LP.Character) end
    
    local conn3 = LP.CharacterAdded:Connect(function(newChar)
        newChar:WaitForChild("Humanoid")
        if godModeEnabled then
            task.wait(0.3)
            hookCharacter(newChar)
        end
    end)
    table.insert(godConnections, conn3)
end

function disableGodMode()
    godModeEnabled = false
    if godModeThread then task.cancel(godModeThread); godModeThread = nil end
    for _, conn in ipairs(godConnections) do pcall(function() conn:Disconnect() end) end
    godConnections = {}
    pcall(function() LP:LoadCharacter() end)
end

-- 6. ANTI-FLING MEJORADO
local antiFlingEnabled = false
local antiFlingConn = nil

function enableAntiFling()
    if antiFlingEnabled then return end
    antiFlingEnabled = true
    
    local function protectChar(char)
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        
        for _, obj in ipairs(hrp:GetChildren()) do
            if obj:IsA("BodyVelocity") or obj:IsA("BodyForce") or obj:IsA("BodyGyro") then
                if obj.Name ~= "AntiFlingProtect" and obj.Name ~= "FarmBV" then 
                    obj:Destroy() 
                end
            end
        end
        
        local bg = Instance.new("BodyGyro")
        bg.Name = "AntiFlingProtect"
        bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        bg.P = 100000
        bg.D = 10000
        bg.CFrame = hrp.CFrame
        bg.Parent = hrp
        
        antiFlingConn = RunService.Heartbeat:Connect(function()
            if not antiFlingEnabled or not char.Parent or not hrp.Parent then
                bg:Destroy()
                if antiFlingConn then antiFlingConn:Disconnect() end
                return
            end
            
            bg.CFrame = hrp.CFrame
            
            for _, obj in ipairs(hrp:GetChildren()) do
                if (obj:IsA("BodyVelocity") or obj:IsA("BodyForce")) and 
                   obj.Name ~= "AntiFlingProtect" and obj.Name ~= "FarmBV" then
                    obj:Destroy()
                end
            end
            
            local vel = hrp.Velocity.Magnitude
            if vel > 100 then
                local counterForce = Instance.new("BodyVelocity")
                counterForce.Name = "AntiFlingCounter"
                counterForce.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                counterForce.P = 100000
                counterForce.Velocity = -hrp.Velocity * 2
                counterForce.Parent = hrp
                
                task.delay(0.1, function()
                    if counterForce and counterForce.Parent then counterForce:Destroy() end
                end)
            end
        end)
    end
    
    if LP.Character then protectChar(LP.Character) end
    
    LP.CharacterAdded:Connect(function(char)
        char:WaitForChild("HumanoidRootPart")
        if antiFlingEnabled then
            task.wait(0.3)
            protectChar(char)
        end
    end)
end

function disableAntiFling()
    antiFlingEnabled = false
    if antiFlingConn then antiFlingConn:Disconnect(); antiFlingConn = nil end
    if LP.Character then
        local hrp = LP.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            local protect = hrp:FindFirstChild("AntiFlingProtect")
            if protect then protect:Destroy() end
            local counter = hrp:FindFirstChild("AntiFlingCounter")
            if counter then counter:Destroy() end
        end
    end
end

-- 7. FLING CON RETORNO A POSICIÓN ORIGINAL
local flingMurdererEnabled = false
local flingGunEnabled = false
local flingAllEnabled = false

function applyFling(targetPlayer)
    if not targetPlayer or not targetPlayer.Character then return end
    local targetHrp = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    local myHrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    
    if not targetHrp or not myHrp then return end
    
    -- 1. GUARDAR POSICIÓN ORIGINAL
    local originalCFrame = myHrp.CFrame
    
    -- 2. Teletransportarse DENTRO del objetivo
    myHrp.CFrame = targetHrp.CFrame
    
    -- 3. Crear fuerza en MI personaje para empujarlo a él por colisión
    local bv = myHrp:FindFirstChild("FlingBV_Me")
    if bv then bv:Destroy() end
    
    bv = Instance.new("BodyVelocity")
    bv.Name = "FlingBV_Me"
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.P = 1000000
    bv.Parent = myHrp
    
    -- Dirección aleatoria hacia arriba
    bv.Velocity = Vector3.new(
        math.random(-500, 500),
        1000,
        math.random(-500, 500)
    )
    
    -- 4. DESPUÉS DE 1.5 SEGUNDOS, VOLVER A POSICIÓN ORIGINAL
    task.delay(1.5, function()
        if bv and bv.Parent then bv:Destroy() end
        if myHrp and myHrp.Parent then
            myHrp.CFrame = originalCFrame
        end
    end)
end

function applyFlingAll()
    for _, p in pairs(Players:GetPlayers()) do if p ~= LP and p.Character then applyFling(p) end end
end
function applyFlingMurderer()
    for _, p in pairs(Players:GetPlayers()) do if p ~= LP and p.Character and getRole(p) == "Murderer" then applyFling(p) end end
end
function applyFlingGun()
    for _, p in pairs(Players:GetPlayers()) do if p ~= LP and p.Character and getRole(p) == "Sheriff" then applyFling(p) end end
end

